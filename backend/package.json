{
  "name": "klinthru-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Klinthru backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts",
    "reset:admin-password": "tsx src/scripts/resetAdminPassword.ts",
    "super-admin:set-password": "tsx src/scripts/setSuperAdminPassword.ts",
    "validation:super-admin-password-input": "tsx src/validation/superAdminPasswordInputChecks.ts",
    "validation:check": "tsx src/validation/runValidationChecks.ts",
    "validation:cors": "tsx src/validation/corsChecks.ts",
    "validation:save-diagnostics": "tsx src/validation/saveDiagnosticsChecks.ts",
    "validation:pipeline-master": "tsx src/validation/pipelineMasterChecks.ts",
    "validation:pipeline-metadata-save": "tsx src/validation/pipelineMetadataSaveChecks.ts",
    "validation:asset-master": "tsx src/validation/assetMasterChecks.ts",
    "validation:inspection-records": "tsx src/validation/inspectionRecordChecks.ts",
    "validation:pl001-demo-cleanup": "tsx src/validation/pl001DemoCleanupChecks.ts",
    "validation:pipeline-history-actions": "tsx src/validation/pipelineHistoryActionsChecks.ts",
    "test:integrations": "tsx src/validation/integrationChecks.ts",
    "test:settings-contracts": "tsx src/validation/settingsContractChecks.ts",
    "validation:pipe-data-history": "tsx src/validation/pipeDataHistoryChecks.ts",
    "validation:ai-readiness": "tsx src/validation/aiPredictionsReadinessChecks.ts",
    "validation:corrosion-growth": "tsx src/validation/corrosionGrowthChecks.ts",
    "safety:storage": "tsx src/validation/productionNoMemoryProbe.ts && tsx src/validation/memorySafetyChecks.ts",
    "safety:bootstrap": "tsx src/validation/bootstrapAdminChecks.ts",
    "safety:admin-reset": "tsx src/validation/resetAdminPasswordChecks.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "validation:chainage": "tsx src/validation/chainageChecks.ts",
    "validation:chainage-database": "tsx src/validation/chainageDatabaseChecks.ts",
    "validation:gis-map": "tsx src/validation/gisMapChecks.ts",
    "validation:sensor-lifecycle": "tsx src/validation/sensorLifecycleContractChecks.ts",
    "audit:gis-map": "node src/validation/gisMapAudit.cjs",
    "test:sensor-ingestion": "npm run build && node src/validation/scadaApiChecks.cjs",
    "test:sensors-demo": "npm run build && node src/validation/demoSensorFlowChecks.cjs",
    "validation:super-admin-domain": "tsx src/validation/superAdminDomainChecks.ts",
    "validation:super-admin-api": "tsx src/validation/superAdminApiChecks.ts",
    "validation:neon-readonly-readiness": "tsx src/validation/neonReadOnlyReadiness.ts",
    "notifications:process": "tsx src/scripts/processNotifications.ts",
    "email:super-admin-preview": "tsx src/scripts/sendSuperAdminEmailPreview.ts",
    "email": "npm run email:super-admin-preview",
    "validation:email-notifications": "tsx src/validation/emailNotificationChecks.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.11.1",
    "@types/pg": "8.15.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "klinthru": "file:..",
    "mqtt": "^5.16.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.1",
    "prisma": "^6.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
