generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Engineer
  Viewer
}

enum CompanyStatus {
  SignupPending
  SignupRejected
  Approved
  TrialActive
  TrialExpired
  PaidActive
  PaidExpired
  Suspended
}

enum CompanyMemberRole {
  CompanyAdmin
  Engineer
  Viewer
}

enum MembershipStatus {
  Invited
  Active
  Inactive
}

enum PlatformRoleStatus {
  Active
  Revoked
}

enum ReferralCodeStatus {
  Available
  Redeemed
  Expired
  Revoked
}

enum SubscriptionStatus {
  Trial
  Active
  Expired
  Cancelled
}

enum SubscriptionPlan {
  Annual
}

enum NotificationType {
  CompanyWelcome
  TrialActivated
  TrialExpiryReminder2
  TrialExpired
  SubscriptionActivated
  RenewalReminder30
  RenewalReminder10
  RenewalReminder7
  SubscriptionExpired
  SubscriptionRenewed
  EnquiryAcknowledgement
  EnquiryNotification
  SupportAcknowledgement
  SupportNotification
}

enum PublicSubmissionType {
  Enquiry
  Support
}

enum NotificationStatus {
  Pending
  Sending
  Sent
  Failed
  Cancelled
}

enum TestPointAssetStatus {
  Active
  Inactive
  Maintenance
}

enum ReferenceElectrode {
  CSE
  AgAgCl
  CuCuSO4
}

enum CpMeasurementType {
  ON_POTENTIAL
  INSTANT_OFF_POTENTIAL
  PIPE_TO_SOIL_POTENTIAL
  STRAY_CURRENT
}

enum ProtectionStatus {
  Protected
  UnderProtected
  Critical
  Unknown
}

enum RectifierStatus {
  Active
  Standby
  Fault
  Offline
  Maintenance
}

enum AssetType {
  STATION
  VALVE
  TEST_POST
  RECTIFIER
  COMPRESSOR
  SENSOR
  PUMP
  METER
  PIG_LAUNCHER
  PIG_RECEIVER
  PIPELINE_FITTING
  FLANGE
  INSULATING_JOINT
  PIPELINE_CROSSING
  OTHER
}

enum AssetPhysicalStatus {
  Active
  Inactive
  Maintenance
  Decommissioned
  Unknown
}

enum AssetSide {
  LHS
  RHS
}

enum CpMonitoringSurveyStatus {
  Draft
  Submitted
  Reviewed
  Archived
}

enum ZoneStatus {
  Protected
  UnderProtected
  Critical
  Unknown
}

enum InterferenceStatus {
  Normal
  Monitoring
  Warning
  Critical
}

enum CpCriteriaApprovalStatus {
  Draft
  Approved
  Superseded
  Retired
}

enum CpOperationalStatus {
  WithinCriteria
  Marginal
  OutOfCriteria
  NotAssessed
  Stale
  Invalid
  Unknown
}

enum IliInspectionRunStatus {
  Draft
  Imported
  Reviewed
  Archived
}

enum IliAnomalyOrientation {
  Internal
  External
  Unknown
}

enum IliAssessmentStatus {
  Repair
  Monitor
  Safe
  Pending
}

enum IntegrationConnectorType {
  REST
}

enum IntegrationConnectorStatus {
  Ready
  Degraded
  Failed
  Disabled
}

enum IntegrationEventOperation {
  Test
  MetadataPreview
}

enum IntegrationEventOutcome {
  Success
  Failure
}

enum DocumentApprovalStatus {
  Draft
  Submitted
  UnderReview          @map("Under Review")
  Approved
  ApprovedWithComments @map("Approved with Comments")
  Rejected
  Superseded
  Archived
}

enum DocumentValidityStatus {
  Current
  ReviewDue    @map("Review Due")
  ExpiringSoon @map("Expiring Soon")
  Expired
  NoExpiry     @map("No Expiry")
}

enum DocumentProcessingStatus {
  Uploading
  Processing
  PendingMetadata @map("Pending Metadata")
  ProcessingError @map("Processing Error")
}

model User {
  aiBack_AiModel_ownerId AiModel[] @relation("AiModel_ownerId")
  aiBack_AiModel_createdById AiModel[] @relation("AiModel_createdById")
  aiBack_AiModelVersion_ownerId AiModelVersion[] @relation("AiModelVersion_ownerId")
  aiBack_AiModelVersion_createdById AiModelVersion[] @relation("AiModelVersion_createdById")
  aiBack_AiConfigurationRevision_ownerId AiConfigurationRevision[] @relation("AiConfigurationRevision_ownerId")
  aiBack_AiConfigurationRevision_createdById AiConfigurationRevision[] @relation("AiConfigurationRevision_createdById")
  aiBack_AiInputSnapshot_ownerId AiInputSnapshot[] @relation("AiInputSnapshot_ownerId")
  aiBack_AiInputSnapshot_createdById AiInputSnapshot[] @relation("AiInputSnapshot_createdById")
  aiBack_AiSnapshotSource_ownerId AiSnapshotSource[] @relation("AiSnapshotSource_ownerId")
  aiBack_AiSnapshotSource_createdById AiSnapshotSource[] @relation("AiSnapshotSource_createdById")
  aiBack_AiRunRequest_ownerId AiRunRequest[] @relation("AiRunRequest_ownerId")
  aiBack_AiRunRequest_createdById AiRunRequest[] @relation("AiRunRequest_createdById")
  aiBack_AiRunKey_ownerId AiRunKey[] @relation("AiRunKey_ownerId")
  aiBack_AiRunKey_createdById AiRunKey[] @relation("AiRunKey_createdById")
  aiBack_AiModelRun_ownerId AiModelRun[] @relation("AiModelRun_ownerId")
  aiBack_AiModelRun_createdById AiModelRun[] @relation("AiModelRun_createdById")
  aiBack_AiPrediction_ownerId AiPrediction[] @relation("AiPrediction_ownerId")
  aiBack_AiPrediction_createdById AiPrediction[] @relation("AiPrediction_createdById")
  aiBack_AiForecast_ownerId AiForecast[] @relation("AiForecast_ownerId")
  aiBack_AiForecast_createdById AiForecast[] @relation("AiForecast_createdById")
  aiBack_AiRecommendation_ownerId AiRecommendation[] @relation("AiRecommendation_ownerId")
  aiBack_AiRecommendation_createdById AiRecommendation[] @relation("AiRecommendation_createdById")
  aiBack_AiScenario_ownerId AiScenario[] @relation("AiScenario_ownerId")
  aiBack_AiScenario_createdById AiScenario[] @relation("AiScenario_createdById")
  aiBack_AiModelValidation_ownerId AiModelValidation[] @relation("AiModelValidation_ownerId")
  aiBack_AiModelValidation_createdById AiModelValidation[] @relation("AiModelValidation_createdById")
  aiBack_AiPredictionOutcomeLink_adjudicatedById AiPredictionOutcomeLink[] @relation("AiPredictionOutcomeLink_adjudicatedById")
  aiBack_AiPredictionOutcomeLink_ownerId AiPredictionOutcomeLink[] @relation("AiPredictionOutcomeLink_ownerId")
  aiBack_AiPredictionOutcomeLink_createdById AiPredictionOutcomeLink[] @relation("AiPredictionOutcomeLink_createdById")
  aiBack_AiGovernanceEvent_actorId AiGovernanceEvent[] @relation("AiGovernanceEvent_actorId")
  aiBack_AiGovernanceEvent_ownerId AiGovernanceEvent[] @relation("AiGovernanceEvent_ownerId")
  aiBack_AiGovernanceEvent_createdById AiGovernanceEvent[] @relation("AiGovernanceEvent_createdById")
  aiBack_AiOutboxEvent_ownerId AiOutboxEvent[] @relation("AiOutboxEvent_ownerId")
  aiBack_AiOutboxEvent_createdById AiOutboxEvent[] @relation("AiOutboxEvent_createdById")
  aiBack_AiEventDelivery_ownerId AiEventDelivery[] @relation("AiEventDelivery_ownerId")
  aiBack_AiEventDelivery_createdById AiEventDelivery[] @relation("AiEventDelivery_createdById")
  officialRisksOwned Risk[] @relation("OfficialRiskOwner")
  basisEventActorIdLinks CpDesignBasisEvent[] @relation("CpDesignBasisEvent_actorId")
  basisCheckReviewerIdLinks CpDesignBasisCheck[] @relation("CpDesignBasisCheck_reviewerId")
  basisAssumptionEngineerIdLinks CpDesignBasisAssumption[] @relation("CpDesignBasisAssumption_engineerId")
  basisRevisionCreatedByIdLinks CpDesignBasisRevision[] @relation("CpDesignBasisRevision_createdById")
  basisRevisionSubmittedByIdLinks CpDesignBasisRevision[] @relation("CpDesignBasisRevision_submittedById")
  basisCreatedByIdLinks CpDesignBasis[] @relation("CpDesignBasis_createdById")
  id                    String                      @id @default(cuid())
  name                  String
  email                 String                      @unique
  passwordHash          String
  role                  Role
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now()) @updatedAt
  assessments           Assessment[]
  externalPipeData      ExternalPipeData[]
  reports               Report[]
  pipelines             Pipeline[]
  cpCalculations        CpCalculation[]
  cpSurveys             CpMonitoringSurvey[]
  cpTestPoints          CpTestPoint[]
  cpReadingHistory      CpReadingHistory[]
  cpRectifiers          CpRectifier[]
  cpRectifierReads      CpRectifierReadingHistory[]
  cpProtectionRules     CpProtectionRule[]
  cpCriteriaApprovals   CpCriteriaVersion[]
  cpZones               CpMonitoringZone[]
  deviceRecords         DeviceRecord[]
  sensorAssignments     SensorAssignment[]
  letterHead            LetterHead?
  iliInspectionRuns     IliInspectionRun[]
  iliAnomalies          IliAnomaly[]
  iliAssessments        IliAssessmentResult[]
  integrationConnectors IntegrationConnector[]
  integrationEvents     IntegrationEvent[]
  integrationHubRecords IntegrationHubRecord[]
  scadaConfigChanges    ScadaConfigChange[]
  managedDocuments      ManagedDocument[]
  documentFamilies      DocumentFamily[]
  documentVersions      DocumentVersion[]
  documentLinks         DocumentLink[]
  companyMemberships    CompanyMembership[]
  platformRole          SuperAdmin?
  approvedCompanies     Company[] @relation("CompanyApprovedBy")
  activatedCompanies    Company[] @relation("CompanyActivatedBy")
  subscriptionActions   CompanySubscription[] @relation("SubscriptionActionedBy")
  referralRedemptions   ReferralCode[] @relation("ReferralRedeemedBy")
  auditEvents            AuditLog[] @relation("AuditActor")
}

model LetterHead {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  fileSize    Int
  fileContent Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model DocumentFamily {
  documentFamilyId String            @id @default(cuid()) @map("Document_Family_ID")
  ownerId          String            @map("Owner_ID")
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now()) @map("Created_At")
  documents        ManagedDocument[]

  @@index([ownerId, createdAt])
  @@map("Document_Family")
}

model ManagedDocument {
  basisEvidenceDocumentIdLinks CpDesignBasisEvidence[] @relation("CpDesignBasisEvidence_documentId")
  documentId       String            @id @default(cuid()) @map("Document_ID")
  documentFamilyId String            @map("Document_Family_ID")
  family           DocumentFamily    @relation(fields: [documentFamilyId], references: [documentFamilyId], onDelete: Restrict)
  documentNumber   String?           @map("Document_Number")
  title            String            @map("Title")
  documentType     String            @map("Document_Type")
  category         String            @map("Document_Category")
  description      String?           @map("Description")
  isGlobal         Boolean           @default(false) @map("Is_Global")
  ownerId          String            @map("Owner_ID")
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now()) @map("Created_At")
  updatedAt        DateTime          @updatedAt @map("Updated_At")
  versions         DocumentVersion[]
  links            DocumentLink[]

  @@index([documentFamilyId])
  @@index([ownerId, updatedAt])
  @@index([documentNumber])
  @@map("Managed_Document")
}

model DocumentVersion {
  aiBack_AiModelVersion_artifactDocumentVersionId AiModelVersion[] @relation("AiModelVersion_artifactDocumentVersionId")
  aiBack_AiModelValidation_artifactDocumentVersionId AiModelValidation[] @relation("AiModelValidation_artifactDocumentVersionId")
  aiBack_AiGovernanceEvent_evidenceDocumentVersionId AiGovernanceEvent[] @relation("AiGovernanceEvent_evidenceDocumentVersionId")
  basisEvidenceDocumentVersionIdLinks CpDesignBasisEvidence[] @relation("CpDesignBasisEvidence_documentVersionId")
  documentVersionId String                    @id @default(cuid()) @map("Document_Version_ID")
  documentId        String                    @map("Document_ID")
  document          ManagedDocument           @relation(fields: [documentId], references: [documentId], onDelete: Restrict)
  revision          String?                   @map("Document_Revision")
  fileName          String                    @map("File_Name")
  mimeType          String                    @map("MIME_Type")
  fileSize          Int                       @map("File_Size_Bytes")
  fileHash          String                    @unique @map("File_Hash_SHA256")
  fileContent       Bytes                     @map("File_Content")
  approvalStatus    DocumentApprovalStatus    @default(Draft) @map("Approval_Status")
  validityStatus    DocumentValidityStatus?   @map("Validity_Review_Status")
  processingStatus  DocumentProcessingStatus? @map("Processing_Status")
  uploadedById      String                    @map("Uploaded_By_ID")
  uploadedBy        User                      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt        DateTime                  @default(now()) @map("Uploaded_At")
  issueDate         DateTime?                 @map("Issue_Date")
  reviewDueDate     DateTime?                 @map("Review_Due_Date")
  expiryDate        DateTime?                 @map("Expiry_Date")
  links             DocumentLink[]

  @@unique([documentId, revision])
  @@index([documentId, uploadedAt])
  @@index([approvalStatus, validityStatus])
  @@index([processingStatus])
  @@map("Document_Version")
}

model DocumentLink {
  documentLinkId    String           @id @default(cuid()) @map("Document_Link_ID")
  documentId        String           @map("Document_ID")
  document          ManagedDocument  @relation(fields: [documentId], references: [documentId], onDelete: Restrict)
  documentVersionId String?          @map("Document_Version_ID")
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [documentVersionId], onDelete: Restrict)
  pipelineId        String?          @map("Pipeline_ID")
  pipeline          Pipeline?        @relation("DocumentLinkPipeline", fields: [pipelineId], references: [id], onDelete: Restrict)
  segmentId         String?          @map("Segment_ID")
  segment           Segment?         @relation("DocumentLinkSegment", fields: [segmentId], references: [id], onDelete: Restrict)
  assetId           String?          @map("Asset_ID")
  asset             Asset?           @relation("DocumentLinkAsset", fields: [assetId], references: [id], onDelete: Restrict)
  createdById       String           @map("Created_By_ID")
  createdBy         User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now()) @map("Created_At")

  @@unique([documentId, pipelineId])
  @@unique([documentId, segmentId])
  @@unique([documentId, assetId])
  @@index([documentId])
  @@index([documentVersionId])
  @@index([pipelineId])
  @@index([segmentId])
  @@index([assetId])
  @@map("Document_Link")
}

model Assessment {
  id             String    @id @default(cuid())
  type           String
  pipelineId     String?
  pipeline       Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineName   String
  riskLevel      String
  riskScore      Int
  input          Json
  result         Json
  inspectionDate DateTime?
  createdAt      DateTime  @default(now())
  authorId       String?
  author         User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reports        Report[]  @relation("InspectionReports")

  @@index([authorId])
  @@index([pipelineId])
  @@index([pipelineId, inspectionDate])
  @@index([type, inspectionDate])
  @@index([createdAt])
}

model Report {
  id                  String      @id @default(cuid())
  assessmentId        String
  reportSubmissionKey String?     @unique
  assessmentType      String
  inspectionId        String?
  inspection          Assessment? @relation("InspectionReports", fields: [inspectionId], references: [id], onDelete: SetNull)
  pipelineId          String?
  pipeline            Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineName        String
  riskLevel           String
  input               Json
  result              Json
  generatedAt         DateTime
  createdAt           DateTime    @default(now())
  authorId            String?
  author              User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([pipelineId])
  @@index([assessmentId])
  @@index([inspectionId])
  @@index([createdAt])
}

model ExternalPipeData {
  id           String    @id @default(cuid())
  assessmentId String?   @unique
  type         String    @default("External")
  pipelineId   String?
  pipeline     Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineName String
  pipeId       String?
  locationId   String?
  input        Json
  result       Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([pipelineId])
  @@index([pipelineName])
  @@index([pipeId])
  @@index([locationId])
  @@index([authorId])
  @@index([createdAt])
}

model Pipeline {
  // Chainage Agent: additive preparation only; review draft SQL before deployment.
  chainageOriginMeters        Decimal? @db.Decimal(24, 9)
  chainageOriginName          String?
  chainageOriginDescription   String?
  chainageOriginReference     String?
  chainageOriginLatitude      Float?
  chainageOriginLongitude     Float?
  chainageDirection           ChainageDirection?
  chainagePrecision           Int?
  allowNegativeChainage       Boolean?
  chainageMatchToleranceMeters Decimal? @db.Decimal(24, 9)
  chainageBoundaryPolicy      ChainageBoundaryPolicy?
  parentPipelineId            String?
  parentTieInChainageMeters   Decimal? @db.Decimal(24, 9)
  chainageCalibration         Json?
  chainageCoordinateSystem    String?
  chainageParent              Pipeline? @relation("PipelineChainageBranch", fields: [parentPipelineId], references: [id], onDelete: Restrict)
  chainageBranches            Pipeline[] @relation("PipelineChainageBranch")
  @@index([parentPipelineId])

  inspectionRecords InspectionRecord[]
  aiBack_AiInputSnapshot_pipelineId AiInputSnapshot[] @relation("AiInputSnapshot_pipelineId")
  aiBack_AiRunRequest_pipelineId AiRunRequest[] @relation("AiRunRequest_pipelineId")
  aiBack_AiRunKey_pipelineId AiRunKey[] @relation("AiRunKey_pipelineId")
  aiBack_AiModelRun_pipelineId AiModelRun[] @relation("AiModelRun_pipelineId")
  aiBack_AiPrediction_pipelineId AiPrediction[] @relation("AiPrediction_pipelineId")
  aiBack_AiForecast_pipelineId AiForecast[] @relation("AiForecast_pipelineId")
  aiBack_AiRecommendation_pipelineId AiRecommendation[] @relation("AiRecommendation_pipelineId")
  aiBack_AiScenario_pipelineId AiScenario[] @relation("AiScenario_pipelineId")
  aiBack_AiModelValidation_pipelineId AiModelValidation[] @relation("AiModelValidation_pipelineId")
  aiBack_AiPredictionOutcomeLink_pipelineId AiPredictionOutcomeLink[] @relation("AiPredictionOutcomeLink_pipelineId")
  officialRisks Risk[] @relation("OfficialRiskPipeline")
  basisPipelineIdLinks CpDesignBasis[] @relation("CpDesignBasis_pipelineId")
  id                          String                      @id @default(cuid())
  pipelineCode                String
  normalizedPipelineCode      String
  pipelineName                String
  location                    String?
  serviceOrProduct            String?
  pipeMaterial                String?
  pipeMaterialOther           String?
  pipeGrade                   String?
  pipeGradeOther              String?
  pipeLocationId              String?
  pipeAgeYears                Float?
  pipeLengthKm                Float?
  pipeInsideDiameter          Float?
  pipeOutsideDiameter         Float?
  diameterUnit                String?
  smysMpa                     Float?
  maopBar                     Float?
  nominalWallThickness        Float?
  wallThicknessInputValue     Float?
  wallThicknessUnit           String?
  designPressure              Float?
  designPressureUnit          String?
  coatingType                 String?
  operatingPressure           Float?
  operatingPressureInputValue Float?
  operatingPressureUnit       String?
  installationYear            Int?
  inspectionYear              Int?
  installationDate            DateTime?
  designLife                  Int?
  routeGeometry               Json?
  status                      String                      @default("Active")
  companyId                   String?
  company                     Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdById                 String?
  createdBy                   User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @default(now()) @updatedAt
  @@index([companyId])
  assessments                 Assessment[]
  reports                     Report[]
  externalPipeData            ExternalPipeData[]
  cpCalculations              CpCalculation[]
  cpSurveys                   CpMonitoringSurvey[]
  cpTestPoints                CpTestPoint[]
  cpReadingHistory            CpReadingHistory[]
  cpRectifiers                CpRectifier[]
  cpRectifierReads            CpRectifierReadingHistory[]
  cpProtectionRules           CpProtectionRule[]
  cpCriteriaSets              CpCriteriaSet[]
  cpZones                     CpMonitoringZone[]
  iliInspectionRuns           IliInspectionRun[]
  segments                    Segment[]
  assets                      Asset[]
  scadaTags                   ScadaTag[]
  scadaEvents                 ScadaEvent[]
  scadaAnomalies              ScadaAnomaly[]
  scadaIndicators             ScadaIndicator[]
  dataQualityRecords          DataQualityRecord[]
  pollingConfig               ScadaPollingConfig?
  routingConfig               ScadaRoutingConfig?
  unitMappings                ScadaUnitMapping[]
  configChanges               ScadaConfigChange[]
  documentLinks               DocumentLink[]              @relation("DocumentLinkPipeline")
  monitoringPoints            MonitoringPoint[]

  @@unique([createdById, normalizedPipelineCode])
  @@index([createdById])
  @@index([pipelineName])
  @@index([createdAt])
}

model InspectionRecord {
  id String @id @default(cuid())
  pipelineId String
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  reference String
  type String
  date String
  segmentId String @default("")
  vendor String @default("")
  findings String @default("")
  status String
  nextDue String @default("")
  risk String @default("")
  authorId String
  createdBy String
  createdAt DateTime @default(now())

  @@index([pipelineId, date])
}

model Segment {
  startChainageMeters Decimal? @db.Decimal(24, 9)
  endChainageMeters   Decimal? @db.Decimal(24, 9)
  @@index([pipelineId, startChainageMeters])

  aiBack_AiPrediction_segmentId AiPrediction[] @relation("AiPrediction_segmentId")
  officialRisks Risk[] @relation("OfficialRiskSegment")
  basisScopeSegmentIdLinks CpDesignBasisScope[] @relation("CpDesignBasisScope_segmentId")
  id               String            @id @default(cuid())
  pipelineId       String
  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  segmentId        String
  name             String?
  description      String?
  startKp          String?
  endKp            String?
  coatingType      String?
  cpType           String?
  terrain          String?
  status           String?
  routeGeometry    Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assets           Asset[]
  documentLinks    DocumentLink[]    @relation("DocumentLinkSegment")
  monitoringPoints MonitoringPoint[]

  @@unique([pipelineId, segmentId])
  @@index([pipelineId])
}

model Asset {
  chainageMeters      Decimal? @db.Decimal(24, 9)
  startChainageMeters Decimal? @db.Decimal(24, 9)
  endChainageMeters   Decimal? @db.Decimal(24, 9)
  @@index([pipelineId, chainageMeters])
  @@index([pipelineId, assetType, chainageMeters])

  aiBack_AiPrediction_assetId AiPrediction[] @relation("AiPrediction_assetId")
  officialRisks Risk[] @relation("OfficialRiskAsset")
  basisScopeAssetIdLinks CpDesignBasisScope[] @relation("CpDesignBasisScope_assetId")
  id               String              @id @default(cuid())
  assetId          String
  name             String?
  facilityType     String?
  equipmentType    String?
  assetType        AssetType
  pipelineId       String
  pipeline         Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  segmentId        String?
  segment          Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  kp               String?
  latitude         Float?
  longitude        Float?
  coordinates      String?
  side             AssetSide?
  installationDate DateTime?
  manufacturer     String?
  model            String?
  physicalStatus   AssetPhysicalStatus @default(Unknown)
  parentAssetId    String?
  parentAsset      Asset?              @relation("AssetParent", fields: [parentAssetId], references: [id], onDelete: SetNull)
  childAssets      Asset[]             @relation("AssetParent")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cpTestPoint      CpTestPoint?
  cpRectifier      CpRectifier?
  scadaTags        ScadaTag[]
  documentLinks    DocumentLink[]      @relation("DocumentLinkAsset")
  monitoringPoints MonitoringPoint[]

  @@unique([pipelineId, assetId])
  @@index([pipelineId, assetType])
  @@index([segmentId])
  @@index([parentAssetId])
  @@index([physicalStatus])
}

model IliInspectionRun {
  id                 String                 @id @default(cuid())
  pipelineId         String
  pipeline           Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  runReference       String
  toolType           String
  vendor             String?
  inspectionDate     DateTime
  assessmentStandard String?
  status             IliInspectionRunStatus @default(Draft)
  notes              String?
  sourceMetadata     Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  authorId           String?
  author             User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  anomalies          IliAnomaly[]

  @@unique([pipelineId, runReference])
  @@index([pipelineId, inspectionDate])
  @@index([authorId])
}

model IliAnomaly {
  id                  String                @id @default(cuid())
  inspectionRunId     String
  inspectionRun       IliInspectionRun      @relation(fields: [inspectionRunId], references: [id], onDelete: Cascade)
  featureId           String
  anomalyType         String
  kpKm                Float?
